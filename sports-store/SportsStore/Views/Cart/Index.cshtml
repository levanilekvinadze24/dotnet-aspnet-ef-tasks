@model SportsStore.Models.ViewModels.CartViewModel

<h2>Your Cart</h2>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Qty</th>
            <th>Item</th>
            <th class="text-end">Price</th>
            <th class="text-end">Subtotal</th>
            <th class="text-center">Action</th>  <!-- New column for Remove button -->
        </tr>
    </thead>
    <tbody>
        @foreach (var line in Model.Cart?.Lines ?? Enumerable.Empty<SportsStore.Models.CartLine>())
        {
        <tr>
            <td class="text-center">@line.Quantity</td>
            <td>@line.Product.Name</td>
            <td class="text-end">@line.Product.Price.ToString("c")</td>
            <td class="text-end">@((line.Quantity * line.Product.Price).ToString("c"))</td>
            <td class="text-center">
                <!-- Remove button -->
                <form method="post" asp-action="Remove" asp-controller="Cart">
                    <input type="hidden" name="productId" value="@line.Product.ProductId" />
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                </form>
            </td>
        </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="3" class="text-end">Total:</td>
            <td class="text-end">@Model.Cart?.ComputeTotalValue().ToString("c")</td>
            <td></td>
        </tr>
    </tfoot>
</table>

<div class="text-center">
    <a class="btn btn-primary" href="@Model.ReturnUrl">Continue Shopping</a>
    <a class="btn btn-primary" asp-route="checkout">Checkout</a> <!-- Added Checkout button -->
</div>
